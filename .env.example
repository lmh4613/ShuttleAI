GEMINI_API_KEY=your_gemini_api_key_here
KMA_API_KEY=your_kma_api_key_here

# Web Push PoC (never commit a real private key)
WEB_PUSH_VAPID_PUBLIC_KEY=your_urlsafe_base64_public_key
WEB_PUSH_VAPID_PRIVATE_KEY=path_to_private_key_pem_or_base64_der_key
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
# Optional; when empty, the browser's current ShuttleAI URL is used.
WEB_PUSH_CLICK_URL=
